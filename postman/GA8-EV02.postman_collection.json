      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Incluye _id', () => pm.expect(j).to.have.property('_id'));",
              "pm.collectionVariables.set('empleado_id', j._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Laura Gómez\",\n  \"cargo\": \"Desarrolladora Backend\",\n  \"departamento\": \"Tecnología\",\n  \"salario\": 4500000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}"
        }
